PORT=5000
MONGODB_URI=mongodb://localhost:27017/wedding-plus
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-with-a-long-random-secret
AI_API_KEY=

# Envoi d'e-mails Wedding+ avec Gmail SMTP
